# PulseAudio for the M7 in Linux mode. It NEVER touches the ALSA card (mmap on it = kernel Oops):
# everything goes to a null sink, and m7audio (Android side) reads the sink's monitor through the unix
# socket /run/m7pulse/pcm (directory 0700, root only) and plays it through Android's audioserver.
.fail
load-module module-null-sink sink_name=m7 rate=48000 channels=2 format=s16le sink_properties=device.description=M7-speaker
set-default-sink m7
load-module module-native-protocol-unix auth-anonymous=1 socket=/run/m7pulse/native
load-module module-simple-protocol-unix source=m7.monitor record=true playback=false socket=/run/m7pulse/pcm rate=48000 format=s16le channels=2
